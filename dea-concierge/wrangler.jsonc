{
  "name": "dea-concierge",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-01",
  // Morning digest of yesterday's chats. 12:00 UTC is 7 am Dallas in summer,
  // 6 am in winter. Handled by scheduled() in src/index.js.
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  // Logs switched on in the dashboard on 27 Sep 2026; mirrored here so a
  // wrangler deploy keeps them on.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.dallaseventaudio.com,https://dallaseventaudio.com,https://dallaseventaudio.pages.dev",
    "DAILY_CAP": "400",
    "LEAD_FROM": "concierge@dallaseventaudio.com",
    "LEAD_TO": "steve@dallaseventaudio.com",
    "MODEL": "claude-sonnet-4-5",
    "DIGEST_MODEL": "claude-opus-5-5"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "01d0d578-822c-400c-9065-b2484b6d586c"
    }
  ],
  "kv_namespaces": [
    {
      "id": "c966e79f1d6b44ba99e3bdc6e68934cd",
      "binding": "RATE"
    }
  ]
}