# ─── PERMANENT ────────────────────────────────────────────────────────────
# The David's Bridal Frisco flyer page. Printed QR destination, not a page we
# want competing in search. The page also carries a noindex meta tag; this is
# the belt to that pair of braces, and it must survive the go-live edit below.
/davidsbridalfrisco
  X-Robots-Tag: noindex, nofollow
/davidsbridalfrisco/*
  X-Robots-Tag: noindex, nofollow

# ─── STAGING ONLY. DELETE THIS BLOCK AT GO-LIVE, AND NOTHING ELSE. ────────
# Keeps the preview out of Google so it cannot compete with the live Wix site
# for the same URLs. Delete these three lines only, in the same commit as the
# DNS switch. Do not replace them with index, follow: indexable is the default
# and an explicit header ships on every response forever.
/*
  X-Robots-Tag: noindex, nofollow
# ─────────────────────────────────────────────────────────────────────────

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# There is deliberately no catch-all Cache-Control rule here.
#
# Cloudflare Pages applies every rule whose pattern matches and joins repeated
# header names with a comma, rather than letting the most specific rule win. A
# /* Cache-Control rule is therefore appended to the three rules above, and
# every asset goes out carrying both values at once. The restrictive one is
# read first, which silently cancels the immutable year those rules are for.
#
# This file has no way to say "everything except these directories", so HTML
# uses the platform default instead. After any change here, check that an image
# still reports a single Cache-Control value.

# Browser and home-screen icons. These must sit at the root to be found without
# markup, which puts them outside /images/* and left them revalidating on every
# page load. A month, not the immutable year above: the filenames carry no
# content hash, so an immutable year would strand a replaced logo in tab strips.
/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/icon-512.png
  Cache-Control: public, max-age=2592000
