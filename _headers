# Staging only. Keeps the preview out of Google so it cannot compete with the
# live Wix site for the same URLs. DELETE THIS BLOCK AT GO-LIVE.
/*
  X-Robots-Tag: noindex, nofollow

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
